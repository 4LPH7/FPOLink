# Database (Requires PostgreSQL 15+ for NULLS NOT DISTINCT constraint)
POSTGRES_USER=fpolink
POSTGRES_PASSWORD=fpolink
POSTGRES_DB=fpolink
DATABASE_URL=postgresql+psycopg://fpolink:fpolink@postgres:5432/fpolink

# Auth & Security
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
SEED_ADMIN_PASSWORD=admin123

# Telegram
TELEGRAM_BOT_TOKEN=

# Data Sources
OGD_API_KEY=
